{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/music/products/[productHandle]",
      "regex": "^/music/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPproductHandle": "nxtPproductHandle"
      },
      "namedRegex": "^/music/products/(?<nxtPproductHandle>[^/]+?)(?:/)?$"
    },
    {
      "page": "/shop/policies/[policy]",
      "regex": "^/shop/policies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpolicy": "nxtPpolicy"
      },
      "namedRegex": "^/shop/policies/(?<nxtPpolicy>[^/]+?)(?:/)?$"
    },
    {
      "page": "/shop/[collectionHandle]",
      "regex": "^/shop/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcollectionHandle": "nxtPcollectionHandle"
      },
      "namedRegex": "^/shop/(?<nxtPcollectionHandle>[^/]+?)(?:/)?$"
    },
    {
      "page": "/shop/[collectionHandle]/products/[productHandle]",
      "regex": "^/shop/([^/]+?)/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcollectionHandle": "nxtPcollectionHandle",
        "nxtPproductHandle": "nxtPproductHandle"
      },
      "namedRegex": "^/shop/(?<nxtPcollectionHandle>[^/]+?)/products/(?<nxtPproductHandle>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/music",
      "regex": "^/music(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/music(?:/)?$"
    },
    {
      "page": "/shop",
      "regex": "^/shop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop(?:/)?$"
    },
    {
      "page": "/shop/look",
      "regex": "^/shop/look(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/shop/look(?:/)?$"
    },
    {
      "page": "/tour",
      "regex": "^/tour(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tour(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}